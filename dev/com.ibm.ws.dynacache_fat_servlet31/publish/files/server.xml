<server>
    <featureManager>
        <feature>osgiconsole-1.0</feature>
        <feature>servlet-3.1</feature>
        <feature>webCache-1.0</feature>
        <feature>webCacheMonitor-1.0</feature>
        <feature>restConnector-1.0</feature>
    </featureManager>
    
    <include location="../fatTestPorts.xml"/>

    <distributedMap id="baseCache" libraryRef="idgenerator" />
    <library id="idgenerator">
    	<file name="${shared.config.dir}/lib/idgenerator/idgenerator.jar"/>
    </library>
    
                 
    <keyStore id="defaultKeyStore" password="Liberty" type="jks" location="${shared.resource.dir}/security/key.jks" /> 
    <quickStartSecurity userName="bob" userPassword="bobpassword"/>             
    
     <application type="war" id="dynacachetests" name="dynacachetests" location="dynacachetests.war">
         <classloader commonLibraryRef="idgenerator" />    
     </application>
     
     <executor  id="default" stealPolicy="NEVER" rejectedWorkPolicy="CALLER_RUNS" />
     <executor coreThreads="25"> </executor> 
                 
</server>
