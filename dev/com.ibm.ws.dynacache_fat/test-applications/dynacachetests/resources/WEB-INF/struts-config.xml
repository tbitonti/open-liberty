<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 1.1//EN"
                               "http://jakarta.apache.org/struts/dtds/struts-config_1_1.dtd">

<struts-config>


	<!-- Data Sources -->
	<data-sources></data-sources>

	<!-- Form Beans -->
	<form-beans>
		<form-bean name="loginForm" type="com.ibm.ws.cache.strutstiles.LoginForm" ></form-bean>
	</form-beans>	

	<!-- Global Exeptions -->
	<global-exceptions></global-exceptions>

	<!-- Global Forwards -->
	<global-forwards>

	</global-forwards>

	<!-- Action Mappings -->
	<action-mappings>
		<action path="/child1" type="com.ibm.ws.cache.strutstiles.StrutsChild1">			
		</action>

		<action path="/basic" type="com.ibm.ws.cache.strutstiles.BasicStrutsTest">			
		</action>

		<action path="/stConsumeFragment" type="com.ibm.ws.cache.strutstiles.StrutsConsumeFragment">			
			<forward name="parent" path="/stParent.jsp"></forward>
		</action>
            <action path="/stDNCFragment" type="com.ibm.ws.cache.strutstiles.StrutsDNCFragment">			
			<forward name="parent" path="/stDNCParent.jsp"></forward>
		</action>
		<action path="/stSaveAttrParent" type="com.ibm.ws.cache.strutstiles.StrutsSaveAttributesParent">			
			<forward name="savAttrChild" path="/stSaveAttrChild.do"></forward>
		</action>
 
            <action path="/stDef" type="com.ibm.ws.cache.strutstiles.StrutsTileDefinition">			
			<forward name="target" path="/results.jsp"></forward>
		</action>


		<action path="/login" type="com.ibm.ws.cache.strutstiles.LoginAction" name="loginForm" scope="session" input="stTestForm.jsp" validate="false">			
			<forward name="displayinfo" path="/stDisplayInfo.jsp"></forward>
		</action>

		
		<action path="/stSaveAttrChild" type="com.ibm.ws.cache.strutstiles.StrutsSaveAttributesChild">						
		</action>


		<action path="/forward" type="com.ibm.ws.cache.strutstiles.TestActionForward">
			 <forward name="tojsp" path="/strutsTimeStamp.jsp"></forward>
			 <forward name="tostruts" path="/child1.do"></forward>			
			 <forward name="toservlet" path="/STTimeStamp"></forward>	
			 <forward name="totile" path="/tileParent.jsp?type=jsp"></forward>
			 <forward name="esiforward" path="/esiForwardInclude.jsp"></forward>
			 <forward name="esiParentConsume" path="/strutsChild.jsp"></forward>		
		</action>

		
	</action-mappings>

      <plug-in className="org.apache.struts.tiles.TilesPlugin">
		<set-property property="definitions-config" value="/WEB-INF/tilesDefinitions.xml" />
		<set-property property="definitions-parser-validate" value="false" />
		<set-property property="definitions-debug" value="2" />
		<set-property property="definitions-parser-details" value="2" />
	</plug-in>


	       	

</struts-config>
